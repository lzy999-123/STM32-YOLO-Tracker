@@ -0,0 +1,62 @@
+#ifndef GIMBAL_BUTTON_H
+#define GIMBAL_BUTTON_H
+
+#include <stdint.h>
+
+#define GIMBAL_BUTTON_DEBOUNCE_MS 30U
+#define GIMBAL_BUTTON_LONG_MS 1000U
+#define GIMBAL_BUTTON_NONE 0U
+#define GIMBAL_BUTTON_SHORT 1U
+#define GIMBAL_BUTTON_LONG 2U
+
+typedef struct {
+    uint32_t raw_since;
+    uint32_t pressed_at;
+    uint8_t initialized;
+    uint8_t raw_down;
+    uint8_t stable_down;
+    uint8_t suppress;
+    uint8_t long_sent;
+} GimbalButton;
+
+/* Main-loop polling only. Unsigned elapsed times also handle tick wrap. */
+static uint8_t GimbalButton_Update(GimbalButton *key, uint8_t down, uint32_t now)
+{
+    if (!key->initialized) {
+        key->initialized = 1U;
+        key->raw_down = key->stable_down = down;
+        key->raw_since = key->pressed_at = now;
+        /* A key held through startup/calibration must be released first. */
+        key->suppress = down;
+        return GIMBAL_BUTTON_NONE;
+    }
+    if (down != key->raw_down) {
+        key->raw_down = down;
+        key->raw_since = now;
+    }
+    if (key->raw_down != key->stable_down &&
+        now - key->raw_since >= GIMBAL_BUTTON_DEBOUNCE_MS) {
+        key->stable_down = key->raw_down;
+        if (key->stable_down) {
+            key->pressed_at = key->raw_since;
+            key->long_sent = 0U;
+        } else {
+            uint8_t event = GIMBAL_BUTTON_NONE;
+            if (!key->suppress && !key->long_sent) {
+                /* Use the release edge, excluding release debounce time. */
+                event = key->raw_since - key->pressed_at >= GIMBAL_BUTTON_LONG_MS
+                        ? GIMBAL_BUTTON_LONG : GIMBAL_BUTTON_SHORT;
+            }
+            key->suppress = 0U;
+            return event;
+        }
+    }
+    if (key->stable_down && key->raw_down && !key->suppress && !key->long_sent &&
+        now - key->pressed_at >= GIMBAL_BUTTON_LONG_MS) {
+        key->long_sent = 1U;
+        return GIMBAL_BUTTON_LONG;
+    }
+    return GIMBAL_BUTTON_NONE;
+}
+
+#endif
