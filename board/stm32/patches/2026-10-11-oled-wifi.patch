+void OLED_SetScrollingLine(uint8_t Line, const char *String, uint32_t Offset)
+{
+	uint16_t glyphs[35]; /* SSIDs contain at most 32 bytes plus three spaces. */
+	uint8_t count = 0U;
+	uint8_t columns = 0U;
+	uint8_t index;
+	uint8_t column = 0U;
+	const uint8_t *p = (const uint8_t *)String;
+	uint16_t glyph;
+	uint8_t width;
+	if (Line < 1U || Line > OLED_LINES) return;
+	while (p != NULL && *p != 0U && count < 32U) {
+		glyph = OLED_FindGlyph(OLED_DecodeUTF8(&p));
+		glyphs[count++] = glyph;
+		columns = (uint8_t)(columns + (glyph >= OLED_CHINESE_BASE ? 2U : 1U));
+	}
+	if (columns <= OLED_COLUMNS) {
+		OLED_SetLine(Line, String);
+		return;
+	}
+	for (index = 0U; index < 3U; index++) glyphs[count++] = ' ';
+	index = (uint8_t)(Offset % count);
+	OLED_SetLine(Line, "");
+	while (column < OLED_COLUMNS) {
+		glyph = glyphs[index];
+		width = glyph >= OLED_CHINESE_BASE ? 2U : 1U;
+		if (column + width > OLED_COLUMNS) break;
+		oled_target[Line - 1U][column++] = glyph;
+		if (width == 2U)
+			oled_target[Line - 1U][column++] = (uint16_t)(glyph | OLED_RIGHT_HALF);
+		index = (uint8_t)((index + 1U) % count);
+	}
+}
