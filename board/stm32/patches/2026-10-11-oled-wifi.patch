+    }
+    snprintf(text, sizeof(text), "%s  %s", work_mode ? OLED_TXT_AUTO : OLED_TXT_MANUAL,
+             !link_seen ? OLED_TXT_LINK_WAIT :
+             (now - link_time > LINK_TIMEOUT_MS ? OLED_TXT_LINK_DOWN : OLED_TXT_LINK_OK));
+    OLED_SetLine(3U, text);
+    OLED_SetLine(4U, "PC13 " OLED_TXT_PAGE_HINT);
+}
